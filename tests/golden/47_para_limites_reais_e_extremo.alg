algoritmo "ParaLimitesReaisEExtremo"
var
   i, k: inteiro
   r: real
inicio
   para i de 1 ate 10 / 2 faca
      escreva(i, " ")
   fimpara
   escreval

   para r de 0.5 ate 2.0 passo 0.5 faca
      escreva(r, " ")
   fimpara
   escreval

   para k de 9223372036854775806 ate 9223372036854775807 passo 1 faca
      escreva(k, " ")
   fimpara
   escreval
fimalgoritmo
